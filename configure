    BOLD      => "\033[1m",
    DIM       => "\033[2m",
    ITALIC    => "\033[3m",
    UNDERLINE => "\033[4m",
    
    # Primary colors - matching aa script style
    BLACK     => "\033[30m",
    RED       => "\033[31m",
    GREEN     => "\033[32m",
    YELLOW    => "\033[33m",
    MAGENTA   => "\033[35m",
    CYAN      => "\033[36m",
