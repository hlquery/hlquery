    UNDERLINE => "\033[4m",
    
    # Primary colors - matching aa script style
    BLACK     => "\033[30m",
    RED       => "\033[31m",
    GREEN     => "\033[32m",
    YELLOW    => "\033[33m",
    MAGENTA   => "\033[35m",
    CYAN      => "\033[36m",
    WHITE     => "\033[37m",
    GRAY      => "\033[90m",
    
    # Bright variants - matching aa script
    OKGREEN     => "\033[92m",
    OKCYAN      => "\033[96m",
    OKBLUE      => "\033[94m",
    WARNING     => "\033[1;38;5;208m",  # Orange warning color
    FAIL        => "\033[91m",
    ENDC        => "\033[0m",
    BRIGHT_CYAN => "\033[1;96m",
    BRIGHT_BLUE => "\033[1;94m",
    BRIGHT_WHITE=> "\033[1;97m",
};

