    # Bright variants - matching aa script
    OKGREEN     => "\033[92m",
    OKCYAN      => "\033[96m",
    OKBLUE      => "\033[94m",
    WARNING     => "\033[1;38;5;208m",  # Orange warning color
    FAIL        => "\033[91m",
