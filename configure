    INCLUDE_DIR     => 'include',
    RUN_DIR         => 'run',
    CONFIG_FILE     => 'config.h',
};

sub shell_quote_arg {
    my ($value) = @_;
    $value //= '';
    $value =~ s/'/'"'"'/g;
    return "'$value'";
}

sub shell_quote_args {
    my (@values) = @_;
    return join(' ', map { shell_quote_arg($_) } @values);
}

sub release_stage_for_version {
    my ($version) = @_;
    $version //= '';

    if ($version =~ /(?:^|[._-])rc(\d*)$/i || $version =~ /rc(\d*)$/i) {
        return length($1) ? "release candidate $1" : "release candidate";
    }

    return 'stable';
}

sub is_release_candidate_version {
    my ($version) = @_;
    return release_stage_for_version($version) =~ /^release candidate/ ? 1 : 0;
}

# Global variables
# Use script directory, not current working directory
# This ensures configure works correctly even when run from a different directory
# (e.g., /app/configure run from /tmp will still create Makefile in /app)
my $script_path = $0;
# Convert to absolute path if relative
if ($script_path !~ m{^/}) {
    $script_path = rel2abs($script_path);
}
my $base_path = dirname($script_path);
# Normalize the path (remove . and .. components)
$base_path = rel2abs($base_path);
my $uid = getuid();
my $username = getpwuid($uid);
my $gid = getgid();

# Terminal ANSI support detection
my $ansi_supported = 0;

# Check if terminal supports ANSI colors and Unicode characters
sub detect_terminal_support {
    # Check if we're outputting to a terminal
    return 0 unless -t STDOUT;
    
    # Check TERM environment variable
    my $term = $ENV{TERM} || '';
    return 0 if $term eq 'dumb';
    
    # Check if NO_COLOR is set
    return 0 if $ENV{NO_COLOR};
    
    # Check if FORCE_COLOR is set to 0
    return 0 if $ENV{FORCE_COLOR} && $ENV{FORCE_COLOR} eq '0';
    
    # Check if we're in a CI environment that might not support colors
    return 0 if $ENV{CI} && !$ENV{FORCE_COLOR};
    
    # If we get here, assume ANSI is supported
    return 1;
}

# Initialize terminal support detection
$ansi_supported = detect_terminal_support();


# Character mapping based on terminal support
my %char_map = (
    'checkmark_ok'   => $ansi_supported ? '✔' : '[OK]',
    'checkmark_fail' => $ansi_supported ? '✘' : '[FAIL]',
    'gear'           => $ansi_supported ? '•' : '-',
    'star'           => $ansi_supported ? '•' : '-',
    'arrow'          => $ansi_supported ? '⟶' : '>',
    'asterisk'       => $ansi_supported ? '•' : '*',
    'bullet'         => $ansi_supported ? '•' : '-'
);

# Check if running as root and refuse to continue
sub check_root {
    if ($uid == 0) {
        print_error("You are running this script as root!");
        print_error("hlquery should NEVER be built or run as root for security reasons.");
        print_error("Please run this script as a regular user.");
        print "";
        print WARNING . "If you need to install to system directories, use:" . ENDC . "\n";
        print "  " . OKCYAN . "./configure --prefix=/opt/hlquery" . ENDC . "\n";
        my $make_cmd = get_make_command();
        print "  " . OKCYAN . "$make_cmd" . ENDC . "\n";
        print "  " . OKCYAN . "sudo $make_cmd install" . ENDC . "\n";
        print "";
        exit 1;
    }
}

