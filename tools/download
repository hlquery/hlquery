#!/usr/bin/env perl
use strict;
use warnings;

use Cwd qw(abs_path);
use File::Basename qw(dirname);
use File::Path qw(make_path);
use File::Spec;
use Getopt::Long qw(GetOptions);

my @catalog = (
     {
          name               => 'qwen_0_5',
          family             => 'Qwen2.5 Instruct',
          repo               => 'bartowski/Qwen2.5-0.5B-Instruct-GGUF',
          file               => 'Qwen2.5-0.5B-Instruct-Q4_K_M.gguf',
          size_bytes         => 397808192,
          description        => 'Smallest local Qwen profile for low-memory setups.',
          default            => 0,
          default_max_tokens => 4096,
     },
     {
          name               => 'qwen_1_5',
          family             => 'Qwen2.5 Instruct',
          repo               => 'bartowski/Qwen2.5-1.5B-Instruct-GGUF',
          file               => 'Qwen2.5-1.5B-Instruct-Q4_K_M.gguf',
          size_bytes         => 986048768,
          description        => 'Balanced local Qwen profile for general use.',
          default            => 1,
          default_max_tokens => 4096,
     },
     {
          name               => 'qwen_3',
          family             => 'Qwen2.5 Instruct',
          repo               => 'bartowski/Qwen2.5-3B-Instruct-GGUF',
          file               => 'Qwen2.5-3B-Instruct-Q4_K_M.gguf',
          size_bytes         => 1929903264,
          description        => 'Mid-sized local Qwen profile with better answer quality than the smaller presets.',
          default            => 0,
          default_max_tokens => 4096,
     },
     {
          name               => 'qwen_14',
          family             => 'Qwen2.5 Instruct',
          repo               => 'bartowski/Qwen2.5-14B-Instruct-GGUF',
          file               => 'Qwen2.5-14B-Instruct-Q4_K_M.gguf',
          size_bytes         => 8988110976,
          description        => 'Largest shipped general Qwen profile (higher quality, larger download).',
          default            => 0,
          default_max_tokens => 4096,
     },
     {
          name               => 'qwen_coder_1_5',
          family             => 'Qwen2.5.1 Coder',
          repo               => 'bartowski/Qwen2.5.1-Coder-1.5B-Instruct-GGUF',
          file               => 'Qwen2.5.1-Coder-1.5B-Instruct-Q4_K_M.gguf',
          size_bytes         => 986048896,
          description        => 'Coder-focused Qwen profile for local code prompts.',
          default            => 0,
          default_max_tokens => 4096,
     },
);

my %models_by_name = map { $_->{name} => $_ } @catalog;

my $script_name = File::Basename::basename($0);
my $script_dir  = dirname(abs_path($0) || $0);
my $repo_root   = dirname($script_dir);
my $default_dir = File::Spec->catdir($repo_root, 'run', 'models');

my @requested_models;
my $download_dir = $default_dir;
my $show_help    = 0;
my $show_list    = 0;
my $show_config  = 0;
my $download_all = 0;
my $force        = 0;
my $dry_run      = 0;
my $max_tokens;

GetOptions(
     'help|h'       => \$show_help,
     'list'         => \$show_list,
     'config'       => \$show_config,
     'all'          => \$download_all,
     'force'        => \$force,
     'dry-run'      => \$dry_run,
     'dir=s'        => \$download_dir,
     'model=s@'     => \@requested_models,
     'max-tokens=i' => \$max_tokens,
) or die usage(1);

if ($show_help)
{
     print usage(0);
     exit 0;
}

if ($show_list)
{
     print_model_list();
     exit 0;
}

if ($show_config)
{
     my @config_models = resolve_models();
     print_config_snippet(\@config_models);
     exit 0;
}

my @models = resolve_models();
make_path($download_dir) unless $dry_run || -d $download_dir;
validate_download_dir($download_dir) unless $dry_run;

my $downloader = detect_downloader();
my @downloaded;
my @skipped;

for my $model (@models)
{
     my $target_path = File::Spec->catfile($download_dir, $model->{file});
     my $url         = build_hf_url($model->{repo}, $model->{file});

     if ($dry_run)
     {
          print "[dry-run] $model->{name}\n";
          print "          url: $url\n";
          print "          dst: $target_path\n";
          next;
     }

     if (-e $target_path && !$force)
     {
          if (!is_complete_model_file($model, $target_path))
          {
               die "Existing model file is incomplete or has the wrong size: $target_path\n"
                    . "Expected " . format_bytes($model->{size_bytes}) . ", found "
                    . format_bytes(-s $target_path) . ". Re-run with --force to replace it.\n";
          }

          print "[skip] $model->{name} already exists at $target_path\n";
          push @skipped, $model;
          next;
     }

     validate_target_path($target_path);
     ensure_sufficient_space($download_dir, $model->{size_bytes}, $target_path);
     print "[download] $model->{name} -> $target_path\n";
     run_downloader($downloader, $url, $target_path);
     push @downloaded, $model;
}

print_summary(\@models, \@downloaded, \@skipped);
print_config_snippet(\@models);
exit 0;

sub usage
{
     my ($exit_code) = @_;
     my $default_models = join(', ', map { $_->{name} } grep { $_->{default} } @catalog);

     return <<"USAGE";
Usage: $script_name [options]

Downloads local GGUF models into run/models for hlquery.

By default this script downloads a balanced shipped Qwen model:
  $default_models

Options:
  --help, -h          Show this help
  --list              List known model presets
  --config            Print a config snippet without downloading
  --model NAME        Download one preset by name, repeatable
  --all               Download every known preset
  --dir PATH          Target directory (default: $default_dir)
  --max-tokens N      Override the recommended max token hint in output
  --force             Re-download even if the file already exists
  --dry-run           Show what would be downloaded without fetching files

Examples:
  ./$script_name
  ./$script_name --model qwen_14
  ./$script_name --model qwen_0_5 --model qwen_coder_1_5
  ./$script_name --list
  ./$script_name --config --model qwen_14
USAGE
}

sub print_model_list
{
     print "Known model presets:\n";

     for my $model (@catalog)
     {
          my $default_label = $model->{default} ? ' [default]' : '';
          print "  $model->{name}$default_label\n";
          print "    family: $model->{family}\n";
          print "    file:   $model->{file}\n";
          print "    repo:   $model->{repo}\n";
          print "    tokens: " . effective_max_tokens($model) . "\n";
          print "    note:   $model->{description}\n";
     }
}

sub resolve_models
{
     if ($download_all)
     {
          return @catalog;
     }

     if (!@requested_models)
     {
          return grep { $_->{default} } @catalog;
     }

     my %seen;
     my @resolved;

     for my $name (@requested_models)
     {
          die "Unknown model preset '$name'. Use --list to see valid names.\n"
               unless exists $models_by_name{$name};

          next if $seen{$name}++;
          push @resolved, $models_by_name{$name};
     }

     return @resolved;
}

sub build_hf_url
{
     my ($repo, $file) = @_;
     return "https://huggingface.co/$repo/resolve/main/$file?download=true";
}

sub detect_downloader
{
     for my $candidate (qw(curl wget))
     {
          my $path = `command -v $candidate 2>/dev/null`;
          chomp $path;

          if ($path ne '')
          {
               return $candidate;
          }
     }

     die "Neither curl nor wget is available. Install one of them first.\n";
}

sub run_downloader
{
     my ($downloader, $url, $target_path) = @_;
     my $temp_path = "$target_path.part";
     unlink $temp_path if -e $temp_path;

     if ($downloader eq 'curl')
     {
          my $status = system('curl', '-fL', '--progress-bar', '-o', $temp_path, $url);
          die downloader_error('curl', $status, $url, $temp_path) if $status != 0;
     }
     else
     {
          my $status = system('wget', '-O', $temp_path, $url);
          die downloader_error('wget', $status, $url, $temp_path) if $status != 0;
     }

     rename $temp_path, $target_path
          or die "Failed to move $temp_path to $target_path: $!\n";
}

sub validate_download_dir
{
     my ($dir) = @_;

     die "Download destination is not a directory: $dir\n" unless -d $dir;
     die "Download destination is not writable: $dir\n" unless -w $dir;
}

sub validate_target_path
{
     my ($target_path) = @_;
     my $temp_path = "$target_path.part";

     die "Download target is a directory, not a file: $target_path\n" if -d $target_path;
     die "Temporary download target is a directory, not a file: $temp_path\n" if -d $temp_path;
}

sub is_complete_model_file
{
     my ($model, $target_path) = @_;

     return 0 unless -f $target_path;
     return (-s $target_path) == $model->{size_bytes};
}

sub ensure_sufficient_space
{
     my ($dir, $required_bytes, $target_path) = @_;
     my $available_bytes = available_bytes($dir);

     return unless defined $available_bytes;

     my $existing_bytes = (-f $target_path) ? (-s $target_path) : 0;
     my $needed_bytes = $required_bytes - $existing_bytes;
     $needed_bytes = 0 if $needed_bytes < 0;

     die "Not enough free space in $dir for download.\n"
          . "Need at least " . format_bytes($needed_bytes) . ", available "
          . format_bytes($available_bytes) . ".\n"
          if $available_bytes < $needed_bytes;
}

sub available_bytes
{
     my ($dir) = @_;

     open(my $df, '-|', 'df', '-Pk', $dir) or return undef;
     my @lines = <$df>;
     close($df) or return undef;

     return undef if @lines < 2;

     my @fields = split(/\s+/, $lines[-1]);
     return undef if @fields < 4 || $fields[3] !~ /^\d+$/;

     return $fields[3] * 1024;
}

sub downloader_error
{
     my ($downloader, $status, $url, $temp_path) = @_;
     my $exit_code = ($status == -1) ? 'failed to start' : ($status >> 8);

     return "$downloader failed while downloading $url\n"
          . "Temporary output: $temp_path\n"
          . "Exit code: $exit_code\n"
          . "If this says curl error 23 / write failure, check destination permissions, disk quota, and free space.\n";
}

sub format_bytes
{
     my ($bytes) = @_;

     return 'unknown' unless defined $bytes;

     my @units = qw(B KiB MiB GiB TiB);
     my $value = $bytes;
     my $unit = 0;

     while ($value >= 1024 && $unit < $#units)
     {
          $value /= 1024;
          $unit++;
     }

     return $unit == 0 ? "$bytes $units[$unit]" : sprintf('%.1f %s', $value, $units[$unit]);
}

sub effective_max_tokens
{
     my ($model) = @_;
     return defined($max_tokens) ? $max_tokens : $model->{default_max_tokens};
}

sub print_summary
{
     my ($all_models, $downloaded, $skipped) = @_;

     print "\nSummary:\n";
     print "  requested: " . scalar(@$all_models) . "\n";
     print "  downloaded: " . scalar(@$downloaded) . "\n";
     print "  skipped: " . scalar(@$skipped) . "\n";
     print "  models_dir: $download_dir\n";
}

sub print_config_snippet
{
     my ($models) = @_;
     my $default_name = $models->[0]{name};
     my $token_hint   = effective_max_tokens($models->[0]);

     print "\nSuggested config:\n";
     print "# Recommended default max tokens for these Qwen presets: $token_hint\n";
     print "<llm\n";
     print "     models_dir=\"run/models\"\n";
     print "     model_name=\"$default_name\">\n\n";

     for my $index (0 .. $#{$models})
     {
          my $model = $models->[$index];
          my $default_attr = $index == 0 ? ' default="true"' : '';
          print "<model name=\"$model->{name}\" file=\"$model->{file}\"$default_attr>\n";
     }

     print "\n# Default model name: $default_name\n";
}
