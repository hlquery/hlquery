#!/usr/bin/env perl

use strict;
use warnings;
use File::Basename qw(dirname);
use File::Spec;
use File::Temp qw(tempfile);

sub schema_for_mode {
    my ($mode) = @_;

    return '{"collection_about":"...","document_role":"...","contexts":[{"term":"...","relation":"...","confidence":0.85,"evidence":"...","scope":"document"}]}'
        if $mode eq 'context';

    return '{"anchors":[{"text":"...","kind":"anchor","confidence":0.85,"reason":"...","language":"..."}]}'
        if $mode eq 'anchors';

    return '{"interpretation":"...","conclusion":"...","candidates":[{"text":"...","weight":0.85}],"ranked_terms":[{"text":"...","weight":0.85}]}';
}

sub read_file {
    my ($path) = @_;
    open my $fh, '<:raw', $path or die "unable to read $path: $!\n";
    local $/;
    return <$fh>;
}

sub extract_json {
    my ($raw) = @_;

    for (my $start = 0; $start < length($raw); $start++) {
        my $open = substr($raw, $start, 1);
        next unless $open eq '{' || $open eq '[';

        my $close = $open eq '{' ? '}' : ']';
        my $depth = 0;
        my $in_string = 0;
        my $escape = 0;

        for (my $i = $start; $i < length($raw); $i++) {
            my $ch = substr($raw, $i, 1);

            if ($in_string) {
                if ($escape) {
                    $escape = 0;
                } elsif ($ch eq '\\') {
                    $escape = 1;
                } elsif ($ch eq '"') {
                    $in_string = 0;
                }
                next;
            }

            if ($ch eq '"') {
                $in_string = 1;
            } elsif ($ch eq $open) {
                $depth++;
            } elsif ($ch eq $close) {
                $depth--;
                return substr($raw, $start, $i - $start + 1) if $depth == 0;
            }
        }
    }

    return '';
}

sub build_prompt {
    my ($mode, $payload) = @_;

    if (length($payload) > 14000) {
        $payload = substr($payload, 0, 14000);
    }

    return
        "You improve retrieval for a local search engine. Analyze the JSON payload using only its supplied evidence. " .
        "Return exactly one compact JSON object on one line. Do not emit markdown or explanatory prose. " .
        "Keep phrases short, specific, and useful for search. Do not invent unsupported facts. " .
        "Use confidence and weight values between 0.55 and 1.0 for useful results.\n" .
        "Mode: $mode\n" .
        "Required schema: " . schema_for_mode($mode) . "\n" .
        "Payload:\n" .
        $payload;
}

my $model = $ENV{HLQUERY_LLM_MODEL} // '';
my $mode = $ENV{HLQUERY_LLM_PAYLOAD_MODE} // 'context';
my $payload_file = $ENV{HLQUERY_LLM_PAYLOAD_JSON_FILE} // '';
my $threads = $ENV{HLQUERY_LLAMA_THREADS} // '1';

die "HLQUERY_LLM_MODEL is not set\n" if $model eq '';
die "HLQUERY_LLM_PAYLOAD_JSON_FILE is not set\n" if $payload_file eq '';

my $repo_root = File::Spec->rel2abs(File::Spec->catdir(dirname(__FILE__), '..'));
my $llama_completion = File::Spec->catfile($repo_root, 'vendor', 'llama.cpp', 'build', 'bin', 'llama-completion');

if (!-x $llama_completion) {
    die "llama-completion is missing; run `make llama-runtime-tools`\n";
}

my $payload = read_file($payload_file);
my $prompt = build_prompt($mode, $payload);

if ($ENV{HLQUERY_LLM_DEBUG_TRACE}) {
    print STDERR "HLQUERY_LLM_DEBUG_QUESTION_BEGIN mode=$mode\n";
    print STDERR $prompt;
    print STDERR "\nHLQUERY_LLM_DEBUG_QUESTION_END mode=$mode\n";
}

my ($prompt_fh, $prompt_path) = tempfile('hlquery-llm-prompt-XXXXXX', TMPDIR => 1, UNLINK => 1);
binmode $prompt_fh;
print {$prompt_fh} $prompt;
close $prompt_fh;

my $max_tokens = $mode eq 'context' ? 320 : 192;

my @cmd = (
    $llama_completion,
    '--model', $model,
    '--file', $prompt_path,
    '--threads', $threads,
    '--threads-batch', $threads,
    '--ctx-size', '4096',
    '--predict', $max_tokens,
    '--temp', '0.2',
    '--top-k', '20',
    '--top-p', '0.9',
    '--json-schema', '{}',
    '--single-turn',
    '--no-display-prompt',
    '--simple-io',
);

my ($raw_fh, $raw_path) = tempfile('hlquery-llm-raw-XXXXXX', TMPDIR => 1, UNLINK => 1);
close $raw_fh;

my $pid = fork();
die "unable to fork llama-completion: $!\n" if !defined $pid;

if ($pid == 0) {
    open STDOUT, '>', $raw_path or die "unable to write $raw_path: $!\n";
    open STDERR, '>&', \*STDOUT or die "unable to redirect stderr: $!\n";
    exec @cmd;
    die "unable to execute llama-completion: $!\n";
}

waitpid($pid, 0);
my $status = $?;
my $raw = read_file($raw_path);
my $json = extract_json($raw);

if ($json ne '') {
    print $json;
    print "\n";
} elsif ($raw ne '') {
    print STDERR $raw;
}

unlink $prompt_path;
unlink $raw_path;

if ($status == -1) {
    die "unable to execute llama-completion: $!\n";
}

exit(($status >> 8) & 0xff);
