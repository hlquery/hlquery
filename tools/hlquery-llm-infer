#!/usr/bin/env perl

use strict;
use warnings;
use FindBin qw($Bin);
use JSON::PP qw(decode_json encode_json);

sub read_file_text {
    my ($path) = @_;
    return '' unless defined $path && $path ne '';

    open my $fh, '<', $path or die "Failed to read $path: $!\n";
    local $/;
    my $content = <$fh>;
    close $fh;
    return defined $content ? $content : '';
}

sub trim {
    my ($value) = @_;
    $value = '' unless defined $value;
    $value =~ s/^\s+//;
    $value =~ s/\s+$//;
    return $value;
}

sub find_executable {
    my ($command) = @_;
    return '' unless defined $command && $command ne '';

    if ($command =~ m{/}) {
        return -f $command && -x $command ? $command : '';
    }

    for my $directory (split /:/, $ENV{PATH} // '') {
        $directory = '.' if $directory eq '';
        my $candidate = "$directory/$command";
        return $candidate if -f $candidate && -x $candidate;
    }

    return '';
}

sub compact_json {
    my ($value, $max_length) = @_;
    return '{}' unless defined $value;
    $max_length = 2400 unless defined $max_length;

    my $encoded = eval { encode_json($value) };
    return '{}' unless defined $encoded && $encoded ne '';

    return length($encoded) > $max_length ? substr($encoded, 0, $max_length) . '...' : $encoded;
}

sub build_prompt_text {
    my ($payload, $mode, $limit) = @_;

    my $title = trim($payload->{title} // '');
    my $content = trim($payload->{content} // '');
    my $fields = $payload->{fields};
    my @field_lines;

    if (ref($fields) eq 'HASH') {
        for my $key (sort keys %$fields) {
            my $value = $fields->{$key};
            my $text = '';

            if (ref($value) eq 'ARRAY') {
                $text = join(', ', map { trim($_) } @$value);
            } elsif (!ref($value)) {
                $text = trim($value);
            }

            next if $text eq '';
            push @field_lines, "$key: $text";
        }
    }

    if (length($content) > 1200) {
        $content = substr($content, 0, 1200);
    }

    my $field_text = join("\n", @field_lines);
    my $prompt_envelope = ref($payload->{prompt}) eq 'HASH' ? $payload->{prompt} : {};
    my $instruction = trim($prompt_envelope->{instruction} // $payload->{instruction} // '');
    $instruction = 'Infer the document domain from the supplied fields and text. Generate search phrases that could help find this exact document without assuming any collection-specific topic.' if $instruction eq '';
    my $collection_profile = compact_json($payload->{collection_profile});

    if ($mode eq 'context') {
        return <<"PROMPT";
You are improving retrieval context for one document inside a search collection.
Return exactly one compact JSON object on a single line. No markdown. No prose before or after the JSON.
JSON schema:
{
  "collection_about": "...",
  "document_role": "...",
  "contexts": [{"term":"...", "relation":"...", "confidence":0.0, "evidence":"...", "scope":"document"}]
}
Work internally in three passes before producing the JSON.
Pass 1: infer what this collection is actually about from its name, schema, metadata, learned summary, and this document.
Pass 2: draft candidate contexts for distinct search behaviors: exact lookup, alias lookup, category browsing, location lookup, and descriptive outside-in discovery.
Pass 3: run this retrieval QA checklist and revise:
1. Searcher wording: what would a real user type if they knew the entity, only an alias, only a location, or only a distinguishing description?
2. Distinguishing evidence: which facts separate this document from similar documents in the same collection?
3. Missing paths: are any grounded aliases, abbreviations, locations, categories, topics, roles, or stable related queries absent?
4. Ambiguity: could a proposed phrase match many unrelated documents or a nearby alternative more strongly than this one?
5. Collection noise: is a phrase merely a collection-wide background word listed in learned_profile.negative_terms?
6. Evidence quality: can each phrase be justified by document evidence or a stable collection-supported relationship?
7. Search value: would indexing this phrase improve recall without materially damaging precision?
Rules:
- collection_about: one short concrete sentence describing the collection domain.
- document_role: one short concrete sentence describing what this document contributes to that domain.
- contexts: up to $limit useful suggestions, ordered strongest-first.
- relation must be one of alias, metro_area, location, category, topic, or related_query.
- confidence values must be between 0.0 and 1.0.
- evidence: one short source-grounded reason.
- scope must be document.
- Each term must be 1 to 8 words.
- Include aliases, locations, categories, topics, and related queries when grounded in the document.
- Prefer concise natural-language queries and stable entity phrases.
- Cover multiple realistic search behaviors when the evidence supports them; do not produce several cosmetic rewrites of the same phrase.
- Avoid generic filler, invented facts, and near duplicates.
- Use collection context to disambiguate the document, but do not emit broad collection labels unless they help find this exact item.
- Treat learned_profile.negative_terms as collection-wide background words: avoid returning them unless combined with document-specific evidence.
- Use learned_profile.summary as the current collection hypothesis and correct it only when this document provides stronger evidence.
- Do not assume a domain, language, gender, or collection topic unless supported by the collection profile or document.

Instruction: $instruction
Collection profile: $collection_profile

Title: $title
Fields:
$field_text
Content: $content
PROMPT
    }

    if ($mode eq 'search_intent') {
        my $collection = trim($payload->{collection} // '');
        my $query = trim($payload->{query} // '');
        my $candidates = $payload->{candidates};
        my @candidate_lines;

        if (ref($candidates) eq 'ARRAY') {
            my $index = 1;

            for my $candidate (@$candidates) {
                next unless ref($candidate) eq 'HASH';

                my $title = trim($candidate->{title} // '');
                my $id = trim($candidate->{id} // '');
                my $content = trim($candidate->{content} // '');
                my $fields = $candidate->{fields};
                my @details;

                if (ref($fields) eq 'HASH') {
                    for my $key (sort keys %$fields) {
                        my $value = $fields->{$key};
                        my $text = '';

                        if (ref($value) eq 'ARRAY') {
                            $text = join(', ', map { trim($_) } @$value);
                        } elsif (!ref($value)) {
                            $text = trim($value);
                        }

                        next if $text eq '';
                        push @details, "$key: $text";
                    }
                }

                if (length($content) > 160) {
                    $content = substr($content, 0, 160);
                }

                my $detail_text = join(' | ', @details);

                if (length($detail_text) > 160) {
                    $detail_text = substr($detail_text, 0, 160);
                }

                push @candidate_lines, "Candidate $index: title=$title ; id=$id ; details=$detail_text ; content=$content";
                $index++;
            }
        }

        my $candidate_text = join("\n", @candidate_lines);
        my $search_collection_profile = compact_json($payload->{collection_profile}, 1200);

        return <<"PROMPT";
You analyze one batch of candidate documents for a user search query.
Return exactly one compact JSON object on a single line. No markdown. No prose before or after the JSON.
JSON schema:
{
  "interpretation": "...",
  "conclusion": "...",
  "candidates": [{"text":"...", "weight":0.0}],
  "ranked_terms": [{"text":"...", "weight":0.0}]
}
Work internally in three passes before producing the JSON.
Pass 1: classify the likely search behavior: exact entity lookup, alias or abbreviation, category browse, location browse, descriptive query, role or epithet, or ambiguous exploratory query.
Pass 2: compare supplied candidates using collection-aware evidence.
Pass 3: run this retrieval QA checklist and revise:
1. What specific intent does the wording imply, and which query tokens are decisive?
2. Which candidate has the strongest direct evidence, and which candidate is the strongest confusing alternative?
3. What fact separates the best candidate from that alternative?
4. Are ranked terms useful retrieval bridges, or are they generic words that would broaden results too much?
5. Is any association speculative, weak, or unsupported by the collection profile and candidate evidence?
6. Should candidates be empty because the evidence is insufficient?
Rules:
- interpretation: one short sentence describing what the user most likely wants.
- conclusion: one short sentence naming the best likely target when the evidence supports it.
- candidates: up to $limit likely target entities or subjects, ordered best-first. Use the supplied candidate title exactly when selecting a document.
- ranked_terms: up to @{[ $limit * 2 ]} search terms or entity phrases that should help re-rank the collection toward the real target.
- Each text must be 1 to 8 words.
- weight values must be between 0.0 and 1.0.
- Prefer canonical entities or subject names over generic genre words.
- Consider stable indirect relationships that improve discovery: aliases, synonyms, abbreviations, metro areas, locations, categories, topics, and commonly associated entities.
- A relationship may be useful even when its wording is absent from the document. For example, a Boston query can reasonably include MIT because MIT is in the Boston metro area.
- Rank only real supplied candidates as likely targets. Use general knowledge conservatively and avoid weak or speculative associations.
- Return an empty candidates array when no supplied document has a meaningful relationship to the query.
- Keep ranked_terms specific to meaningful relationships found in this batch. Do not emit generic filler merely to fill the limit.
- If the query sounds like a nickname, title, crown, role, or epithet, resolve it to the most likely subject from the candidates.
- Use the candidate set as evidence, but do not just copy the current top hit if another candidate is a better semantic fit.
- Favor terms that can be looked up directly inside the collection.
- Prefer the narrowest useful interpretation. Broaden only when the query itself is exploratory.

Collection: $collection
Collection profile: $search_collection_profile
Query: $query
Candidates:
$candidate_text
PROMPT
    }

    if ($mode eq 'anchors') {
        return <<"PROMPT";
You generate precise anchor, alias, descriptor, and query suggestions for one search document.
Return exactly one compact JSON object on a single line. No markdown. No prose before or after the JSON.
JSON schema:
{
  "anchors": [{"text":"...", "kind":"anchor", "confidence":0.0, "reason":"...", "language":"..."}]
}
Work internally in three passes before producing the JSON.
Pass 1: identify canonical entities and structured facts.
Pass 2: draft anchors for exact lookup, alias lookup, disambiguation, and outside-in discovery.
Pass 3: run this retrieval QA checklist and revise:
1. Which phrase is the canonical anchor?
2. Which supported aliases, abbreviations, alternate spellings, roles, locations, or identifiers are genuinely searchable?
3. Which phrase best distinguishes this document from nearby alternatives in the collection?
4. Is any phrase merely a broad collection label or a cosmetic title rewrite?
5. Does every phrase have a short evidence-backed reason?
6. Would each phrase improve search precision or recall enough to justify indexing it?
Rules:
- anchors: up to $limit useful indexing phrases, ordered best-first.
- kind must be one of anchor, alias, descriptor, or query.
- confidence values must be between 0.0 and 1.0.
- Each text must be 1 to 8 words.
- Prefer exact entities, aliases, roles, labels, and high-precision query phrases grounded in the document.
- Include disambiguating combinations when a short alias or subject is likely ambiguous.
- Avoid ids, urls, handles, timestamps, boilerplate, generic filler, and near duplicates.
- Do not invent facts not supported by the title, fields, or content.

Instruction: $instruction
Collection profile: $collection_profile

Title: $title
Fields:
$field_text
Content: $content
PROMPT
    }

    return <<"PROMPT";
You generate retrieval-oriented structured reasoning for one document.
Return exactly one compact JSON object on a single line. No markdown. No prose before or after the JSON.
JSON schema:
{
  "language": ["..."],
  "document_type": "...",
  "distinctive_entities": [{"text":"...", "weight":0.0}],
  "outside_in_queries": [{"text":"...", "weight":0.0}],
  "search_queries": [{"text":"...", "weight":0.0}]
}
Work internally in three passes before producing the JSON:
Pass 1: infer the collection domain and this document's concrete role inside it.
Pass 2: draft labels, entities, and retrieval phrases for exact lookup, alias lookup, disambiguation, category browse, location browse, and descriptive outside-in discovery.
Pass 3: run this retrieval QA checklist and revise:
1. What is this document actually about in concrete retrieval terms?
2. What would users search if they knew the title, only an alias, only a location, only a role, or only a distinctive fact?
3. Which facts distinguish this item from similar collection documents?
4. Which labels, language clues, roles, locations, dates, mediums, or identifiers are underused?
5. Which draft phrases are generic, cosmetic rewrites, collection-wide noise, or likely to retrieve unrelated documents?
6. Which outside-in discovery angles are missing but still grounded in evidence?
7. Does every final phrase improve precision, recall, or disambiguation enough to keep?
Rules:
- language: 1 to 3 short language/script tags or names supported by the document.
- document_type: 1 short phrase.
- distinctive_entities: up to $limit short phrases that identify the document from outside; each text must be 2 to 8 words.
- outside_in_queries: up to $limit search phrasings describing how an outsider would discover this document; each text must be 2 to 8 words.
- search_queries: up to $limit high-precision search queries for finding this exact document; each text must be 2 to 8 words.
- weight values must be between 0.0 and 1.0.
- Prefer exact entities, aliases, roles, locations, dates, labels, identifiers, and distinctive wording combinations.
- Prefer retrieval nouns and stable descriptors over sentence fragments, verbs, or narrative continuations.
- Do not copy labels blindly when they look synthetic, benchmark-like, or obviously fake.
- Infer the document domain from the supplied fields and text.
- Use any language, script, or terminology that the document itself supports.
- Do not assume a domain, language, gender, or collection topic unless it is supported by the document.
- Avoid generic filler and near-duplicate phrasings.
- Prefer stronger coverage over minimal output when the document contains enough evidence.
- If the first draft is weak, broaden the second-pass phrases using outside-in discovery language rather than repeating title words.

Instruction: $instruction
Collection profile: $collection_profile

Title: $title
Fields:
$field_text
Content: $content
PROMPT
}

sub normalize_output_line {
    my ($line) = @_;
    $line = trim($line);
    $line =~ s/^\d+[\.\)]\s*//;
    $line =~ s/^[-*]\s*//;
    $line =~ s/^["']+//;
    $line =~ s/["']+$//;
    $line =~ s/\s+/ /g;
    return trim($line);
}

sub push_unique_phrase {
    my ($target, $seen, $limit, $phrase) = @_;
    $phrase = normalize_output_line($phrase);
    return if $phrase eq '';
    return if length($phrase) < 3;
    my $key = lc($phrase);
    return if $seen->{$key}++;
    push @$target, $phrase;
    return if @$target >= $limit;
}

sub heuristic_phrases {
    my ($payload, $limit) = @_;
    my @results;
    my %seen;

    my $title = trim($payload->{title} // '');
    my $content = trim($payload->{content} // '');
    my $fields = $payload->{fields};
    my $description = '';
    my @field_values;

    if (ref($fields) eq 'HASH') {
        $description = trim($fields->{description} // '');
        for my $key (sort keys %$fields) {
            my $value = $fields->{$key};

            if (ref($value) eq 'ARRAY') {
                push @field_values, map { trim($_) } @$value;
            } elsif (!ref($value) && defined $value && $value ne '') {
                push @field_values, map { trim($_) } split /,/, $value;
            }
        }
    }

    my @title_tokens = grep { $_ ne '' } map { lc($_) } split /[^A-Za-z0-9]+/, $title;
    my @field_tokens = grep { $_ ne '' } map { lc($_) } @field_values;

    push_unique_phrase(\@results, \%seen, $limit, $title);

    if (@title_tokens >= 2) {
        push_unique_phrase(\@results, \%seen, $limit, join(' ', @title_tokens[0, 1]));
    }

    if (@field_tokens >= 2) {
        push_unique_phrase(\@results, \%seen, $limit, join(' ', @field_tokens[0, 1]));
    }

    if (@field_tokens >= 3) {
        push_unique_phrase(\@results, \%seen, $limit, join(' ', @field_tokens[0, 1, 2]));
    }

    if ($description ne '') {
        push_unique_phrase(\@results, \%seen, $limit, $description);
    }

    my @content_tokens = grep { length($_) >= 4 } map { lc($_) } split /[^A-Za-z0-9]+/, $content;
    if (@content_tokens >= 2) {
        push_unique_phrase(\@results, \%seen, $limit, join(' ', @content_tokens[0, 1]));
    }

    if (@content_tokens >= 3) {
        push_unique_phrase(\@results, \%seen, $limit, join(' ', @content_tokens[0, 1, 2]));
    }

    return @results;
}

sub extract_json_object {
    my ($text) = @_;
    return '' unless defined $text && $text ne '';

    my $start = index($text, '{');
    my $end = rindex($text, '}');
    return '' if $start < 0 || $end < $start;

    my $candidate = substr($text, $start, $end - $start + 1);
    eval { decode_json($candidate); 1 } or return '';
    return $candidate;
}

my $model = $ENV{HLQUERY_LLM_MODEL} // '';
my $context_json = $ENV{HLQUERY_LLM_CONTEXT_JSON} // '';
my $context_json_file = $ENV{HLQUERY_LLM_CONTEXT_JSON_FILE} // '';
my $anchor_json = $ENV{HLQUERY_LLM_ANCHOR_JSON} // '';
my $anchor_json_file = $ENV{HLQUERY_LLM_ANCHOR_JSON_FILE} // '';
my $search_json = $ENV{HLQUERY_LLM_SEARCH_JSON} // '';
my $search_json_file = $ENV{HLQUERY_LLM_SEARCH_JSON_FILE} // '';
my $payload_mode = $ENV{HLQUERY_LLM_PAYLOAD_MODE} // '';
my $payload_json_file = $ENV{HLQUERY_LLM_PAYLOAD_JSON_FILE} // '';
my $sam_json = $ENV{HLQUERY_SAM_DOC_JSON} // '';
my $sam_json_file = $ENV{HLQUERY_SAM_DOC_JSON_FILE} // '';

if (!$model) {
    die "HLQUERY_LLM_MODEL is required\n";
}

my $runner = $ENV{HLQUERY_LLM_RUNNER} // "$Bin/hlquery-llama-runner";

if (find_executable($runner) eq '') {
    print STDERR "HLQUERY_LLM_RUNNER executable not found: $runner. Run 'make llama-runtime-fetch' or set HLQUERY_LLM_RUNNER to a llama-cli path.\n";
    exit 78;
}

my $mode = 'sam';
my $limit = 6;
my $payload_json = $payload_json_file ne '' ? read_file_text($payload_json_file)
                 : ($sam_json_file ne '' ? read_file_text($sam_json_file) : $sam_json);
my $creativity_mode = $ENV{HLQUERY_SAM_CREATIVITY_MODE} // 'balanced';

if ($payload_mode ne '') {
    $mode = $payload_mode;
} elsif ($context_json_file ne '') {
    $payload_json = read_file_text($context_json_file);
    $mode = 'context';
} elsif ($context_json ne '') {
    $payload_json = $context_json;
    $mode = 'context';
} elsif ($anchor_json_file ne '') {
    $payload_json = read_file_text($anchor_json_file);
    $mode = 'anchors';
} elsif ($anchor_json ne '') {
    $payload_json = $anchor_json;
    $mode = 'anchors';
} elsif ($search_json_file ne '') {
    $payload_json = read_file_text($search_json_file);
    $mode = 'search_intent';
} elsif ($search_json ne '') {
    $payload_json = $search_json;
    $mode = 'search_intent';
}

if ($payload_json eq '') {
    die "No LLM payload env was provided\n";
}

my $payload = decode_json($payload_json);

if ($mode eq 'context' && ref($payload) eq 'HASH' && defined $payload->{limit}) {
    $limit = int($payload->{limit});
    $limit = 1 if $limit < 1;
    $limit = 24 if $limit > 24;
}

if ($mode eq 'search_intent' && ref($payload) eq 'HASH' && defined $payload->{limit}) {
    $limit = int($payload->{limit});
    $limit = 1 if $limit < 1;
    $limit = 16 if $limit > 16;
}

if ($mode eq 'anchors' && ref($payload) eq 'HASH' && defined $payload->{limit}) {
    $limit = int($payload->{limit});
    $limit = 1 if $limit < 1;
    $limit = 12 if $limit > 12;
}

if ($mode eq 'sam' && defined $ENV{HLQUERY_SAM_TERM_LIMIT}) {
    $limit = int($ENV{HLQUERY_SAM_TERM_LIMIT});
    $limit = 1 if $limit < 1;
    $limit = 32 if $limit > 32;
}

my $prompt = build_prompt_text($payload, $mode, $limit);
my $debug_trace = ($ENV{HLQUERY_LLM_DEBUG_TRACE} // '') eq '1';

if ($debug_trace) {
    print STDERR "HLQUERY_LLM_DEBUG_QUESTION_BEGIN mode=$mode\n";
    print STDERR $prompt;
    print STDERR "\n" unless $prompt =~ /\n\z/;
    print STDERR "HLQUERY_LLM_DEBUG_QUESTION_END mode=$mode\n";
}

my ($temp, $top_k, $top_p) = (0.2, 20, 0.9);
my $max_tokens = 96;

if ($mode eq 'sam') {
    if ($creativity_mode eq 'creative') {
        ($temp, $top_k, $top_p) = (0.75, 60, 0.95);
    } elsif ($creativity_mode eq 'conservative') {
        ($temp, $top_k, $top_p) = (0.15, 20, 0.85);
    } else {
        ($temp, $top_k, $top_p) = (0.45, 40, 0.92);
    }

    $max_tokens = 192;
} elsif ($mode eq 'context') {
    $max_tokens = 320;
} elsif ($mode eq 'anchors' || $mode eq 'search_intent') {
    $max_tokens = 192;
}

open my $fh, '-|',
    $runner,
    '-m', $model,
    '-p', $prompt,
    '-n', "$max_tokens",
    '--ctx-size', '4096',
    '--temp', "$temp",
    '--top-k', "$top_k",
    '--top-p', "$top_p",
    '--seed', '1',
    '--no-display-prompt',
    '--simple-io',
    '--no-warmup',
    '--log-disable'
    or die "Failed to start $runner: $!\n";

local $/;
my $raw_output = <$fh>;
close $fh;
$raw_output = '' unless defined $raw_output;

if ($debug_trace) {
    print STDERR "HLQUERY_LLM_DEBUG_ANSWER_BEGIN mode=$mode\n";
    print STDERR $raw_output;
    print STDERR "\n" unless $raw_output =~ /\n\z/;
    print STDERR "HLQUERY_LLM_DEBUG_ANSWER_END mode=$mode\n";
}

if ($mode eq 'sam' || $mode eq 'search_intent' || $mode eq 'anchors') {
    my $json = extract_json_object($raw_output);

    if ($json ne '') {
        my $parsed = eval { decode_json($json) };

        if ($parsed && ref($parsed) eq 'HASH') {
            print encode_json($parsed), "\n";
            exit 0;
        }
    }
}

my %seen;
my @results;

for my $line (split /\n/, $raw_output) {
    $line = normalize_output_line($line);

    next if $line eq '';
    last if $line =~ /^>?\s*EOF\b/i;
    next if length($line) < 3;

    my $key = lc($line);
    next if $seen{$key}++;

    push @results, $line;
    last if @results >= $limit;
}

if (!@results) {
    @results = heuristic_phrases($payload, $limit);
}

if (!@results) {
    if ($mode eq 'search_intent') {
        print encode_json({
            interpretation => '',
            conclusion => '',
            candidates => [],
            ranked_terms => [],
        }), "\n";
        exit 0;
    }

    exit 4;
}

print "$_\n" for @results;
exit 0;
