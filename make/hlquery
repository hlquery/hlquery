# Configuration
my $VERSION = "1.0.0";
my $BINARY_NAME = "hlquery";
my $CONFIG_FILE = "conf/hlquery.conf";
my $PID_FILE = "pid/hlquery.pid";
my $LOG_DIR = "logs";

# Colors for output
my $RED = "\033[31m";
my $GREEN = "\033[32m";
my $YELLOW = "\033[33m";
my $BLUE = "\033[34m";
my $CYAN = "\033[36m";
my $BLACK = "\033[30m";
my $BOLD = "\033[1m";
my $RESET = "\033[0m";

# Global variables
my $binary_path;
my $config_path;
my $pid_file_path;
my $log_dir_path;
my $working_dir;

sub print_banner {
    print <<"EOF";
${BOLD}${BLUE}hlquery $VERSION - Search beyond keywords.${RESET}
${BOLD}Released under the BSD License version 3${RESET}

EOF
}

sub print_usage {
    print <<"EOF";
Usage: $0 <command> [options]

Commands:
    start       Start the hlquery server
    stop        Stop the hlquery server gracefully (SIGTERM)
    kill        Force stop the hlquery server (SIGKILL)
    restart     Restart the hlquery server
    status      Show server status
    reload      Reload configuration
    test        Test configuration
    sslgen      Generate SSL certificates
    valdebug    Run server with valgrind for memory debugging
    version     Show version information
    help        Show this help message

Options:
    --nofork        Don't fork into background (foreground mode)
    --debug         Enable debug mode
    --skip-auth     Skip password authentication (dev/testing only)
    --config FILE   Use specified configuration file
    --pidfile FILE  Use specified PID file
    --logdir DIR    Use specified log directory
    --help          Show this help message

Examples:
    $0 start                    # Start server in background
    $0 start --nofork          # Start server in foreground
    $0 start --debug --nofork  # Start with debug in foreground
    $0 start --skip-auth       # Start with authentication bypass (dev/testing)
    $0 stop                     # Stop server gracefully
    $0 kill                     # Force stop server
    $0 restart                  # Restart server
    $0 status                   # Check server status
    $0 valdebug                 # Run with valgrind for memory debugging

EOF
}

sub find_binary {
    my $script_dir = dirname(File::Spec->rel2abs($0));
    my $possible_paths = [
        File::Spec->catfile($script_dir, "bin", $BINARY_NAME),
        File::Spec->catfile($script_dir, "..", "build", "bin", $BINARY_NAME),
        File::Spec->catfile($script_dir, "..", "run", "bin", $BINARY_NAME),
        $BINARY_NAME  # Try PATH
    ];
    
    foreach my $path (@$possible_paths) {
        if (-x $path) {
            return File::Spec->rel2abs($path);
        }
    }
    
    return undef;
}

sub setup_paths {
    $working_dir = File::Spec->rel2abs(dirname(File::Spec->rel2abs($0)));
    
    # Find binary
    $binary_path = find_binary();
    unless ($binary_path) {
        print_error("Could not find hlquery binary. Please ensure it's installed correctly.");
        exit 1;
    }
    
    # Set up paths relative to working directory (remove 'run/' prefix since we're already in run/)
    $config_path = File::Spec->catfile($working_dir, $CONFIG_FILE);
    $pid_file_path = File::Spec->catfile($working_dir, $PID_FILE);
    $log_dir_path = File::Spec->catfile($working_dir, $LOG_DIR);
}

sub print_info {
    my ($msg) = @_;
    print "${BLACK}[${RESET} ${BLUE}INFO${RESET} ${BLACK}]${RESET} $msg\n";
}

sub print_success {
    my ($msg) = @_;
    print "${BLACK}[${RESET} ${GREEN}OK${RESET} ${BLACK}]${RESET} $msg\n";
}

sub print_warning {
    my ($msg) = @_;
    print "${BLACK}[${RESET} ${CYAN}OK${RESET} ${BLACK}]${RESET} $msg\n";

}

sub print_error {
    my ($msg) = @_;
    print "${RED}[ERROR]${RESET} $msg\n";
}

sub is_running {
    return 0 unless -f $pid_file_path;
    
    open my $fh, '<', $pid_file_path or return 0;
    my $pid = <$fh>;
    close $fh;
    chomp $pid;
    
    return 0 unless $pid =~ /^\d+$/;
    
    # Check if process exists
    return kill(0, $pid) ? $pid : 0;
}

sub get_pid {
    return is_running();
}

sub start_server {
    my ($nofork, $debug, $skip_auth, @extra_args) = @_;
    
    if (my $pid = is_running()) {
        print_warning("hlquery is already running (PID: $pid)");
        return 0;
    }
    
    # Check if config file exists
    unless (-f $config_path) {
        print_error("Configuration file not found: $config_path");
        print_info("Please run 'make install' or create a configuration file.");
        return 1;
    }
    
    # Create log directory if it doesn't exist
    unless (-d $log_dir_path) {
        mkdir $log_dir_path, 0755 or do {
            print_error("Could not create log directory: $log_dir_path");
            return 1;
        };
    }
    
    # Build command - only add script-specific flags, pass others to binary
    my @cmd = ($binary_path);
    
    # Add script-specific flags
    push @cmd, "--nofork" if $nofork;
    push @cmd, "--debug" if $debug;
    push @cmd, "--skip-auth" if $skip_auth;
    
    # Add configuration file path
    push @cmd, "--config", $config_path;
    
    # Add any extra arguments passed to the script (excluding start/stop)
    push @cmd, @extra_args;
    
    if ($nofork) {
        # For foreground mode, let the binary handle all output
        # Change to working directory
        chdir $working_dir or do {
            print_error("Could not change to working directory: $working_dir");
            return 1;
        };
        
        # Execute the binary directly - let it handle all output
        exec @cmd;
    } else {
        # For background mode, be completely silent - let the binary handle everything
        # Change to working directory
        chdir $working_dir or do {
            print_error("Could not change to working directory: $working_dir");
            return 1;
        };
        
        # Fork and exec - let binary handle daemonization silently
        # The binary will daemonize itself, so we just need to return immediately
        my $pid = fork();
        if ($pid == 0) {
            # Child - redirect stdin from /dev/null to prevent terminal from waiting
            open(STDIN, '<', '/dev/null') or die "Cannot open /dev/null: $!";
            # Exec binary (it will daemonize itself silently)
            # After exec, this process is replaced by the binary
            exec @cmd;
            # Should never reach here
            exit 1;
        } elsif ($pid > 0) {
            # Parent - wait for binary to print initial messages before returning
            # The binary will daemonize (double fork) and print messages
            # We need to wait long enough for messages to be printed
            $SIG{CHLD} = 'IGNORE';
            # Wait for binary to start, print messages, and daemonize
            # 500ms should be enough for initial messages to appear and be flushed
            select(undef, undef, undef, 0.5);
            return 0;
        } else {
            # Fork failed
            return 1;
        }
    }
}

sub force_stop_server {
    my $pid = is_running();
    
    unless ($pid) {
        print_warning("hlquery is not running");
        # Clean up stale PID file if it exists
        if (-f $pid_file_path) {
            unlink $pid_file_path;
            print_info("Cleaned up stale PID file");
        }
        return 0;
    }
    
    print_info("Force stopping hlquery (PID: $pid) ...");
    my $kill_result = kill('KILL', $pid);
    
    if ($kill_result == 0) {
        # Process doesn't exist
        print_warning("Process $pid does not exist, cleaning up PID file");
        unlink $pid_file_path if -f $pid_file_path;
        return 0;
    }
    
    sleep 2;  # Wait for process to die
    
    if (is_running()) {
        print_error("Failed to kill hlquery");
        return 1;
    } else {
        # Clean up PID file
        if (-f $pid_file_path) {
            unlink $pid_file_path;
        }
        print_success("hlquery killed");
        return 0;
    }
}

sub stop_server {
    my $pid = is_running();
    
    unless ($pid) {
        print_warning("hlquery is not running");
        # Clean up stale PID file if it exists
        if (-f $pid_file_path) {
            unlink $pid_file_path;
            print_info("Cleaned up stale PID file");
        }
        return 0;
    }
    
    print_info("Stopping hlquery (PID: $pid) ...");
    
    # Send TERM signal
    my $term_result = kill('TERM', $pid);
    if ($term_result == 0) {
        # Process doesn't exist, clean up PID file
        print_warning("Process $pid does not exist, cleaning up PID file");
        unlink $pid_file_path if -f $pid_file_path;
        return 0;
    }
    
    # Wait for graceful shutdown
    my $timeout = 10;  # Reduced from 30 to 10 seconds
    my $count = 0;
    
    while ($count < $timeout && is_running()) {
        sleep 1;  # Wait 1 second between checks
        $count++;
    }
    
    if (is_running()) {
        print_warning("Graceful shutdown timed out, sending KILL signal...");
        my $kill_result = kill('KILL', $pid);
        if ($kill_result == 0) {
            # Process doesn't exist anymore
            print_info("Process already terminated");
        } else {
            sleep 2;  # Wait a bit longer after KILL
        }
    }
    
    # Final check and cleanup
    if (is_running()) {
        print_error("Failed to stop hlquery.");
        return 1;
    } else {
        # Clean up PID file
        if (-f $pid_file_path) {
            unlink $pid_file_path;
        }
        print_success("hlquery stopped successfully.");
        return 0;
    }
}

sub restart_server {
    my (@extra_args) = @_;
    print_info("Restarting hlquery...");
    
    my $stop_result = stop_server();
    return $stop_result if $stop_result != 0;
    
    sleep 2;  # Give it time to fully stop and release ports
    
    return start_server(0, 0, 0, @extra_args);  # Start in background without debug or skip-auth, pass extra args
}

sub show_status {
    my $pid = is_running();
    
    if ($pid) {
        print_success("hlquery is running (PID: $pid) ..");
        
        # Show additional info if possible
        if (open my $fh, '<', "/proc/$pid/stat") {
            my $line = <$fh>;
            close $fh;
            my @fields = split ' ', $line;
            if (@fields > 21) {
                my $start_time = $fields[21];
                my $uptime = time - $start_time;
                my $uptime_str = strftime("%H:%M:%S", gmtime($uptime));
                print_info("Uptime: $uptime_str");
            }
        }
        
        # Show listening ports if possible  
        if (open my $fh, '-|', "ss -tlnp 2>/dev/null | grep $pid") {
            my @lines = <$fh>;
            close $fh;
            if (@lines) {
                print_info("Listening on:");
                foreach my $line (@lines) {
                    $line =~ s/\s+/ /g;
                    my @parts = split ' ', $line;
                    if (@parts >= 4) {
                        print_info("  $parts[3]");
                    }
                }
            }
        }
        
        return 0;
    } else {
        print_warning("hlquery is not running");
        return 1;
    }
}

sub test_config {
    unless (-f $config_path) {
        print_error("Configuration file not found: $config_path");
        return 1;
    }
    
    print_info("Testing configuration: $config_path");
    
    # Basic syntax check
    if (open my $fh, '<', $config_path) {
        my $line_num = 0;
        while (my $line = <$fh>) {
            $line_num++;
            chomp $line;
            
            # Skip comments and empty lines
            next if $line =~ /^\s*#/ or $line =~ /^\s*$/;
            
            # Basic XML-like syntax check
            if ($line =~ /<[^>]+>/) {
                # Looks like XML tag
            } elsif ($line =~ /^\s*[^<]/) {
                # Non-XML content
            }
        }
        close $fh;
    }
    
    print_success("Configuration syntax appears valid");
    return 0;
}

sub show_version {
    print_banner();
    print_info("Binary: $binary_path");
    print_info("Config: $config_path");
    print_info("Working directory: $working_dir");
    
    # Try to get binary version
    if (open my $fh, '-|', "$binary_path --version 2>&1") {
        my $version_output = <$fh>;
        close $fh;
        if ($version_output) {
            print_info("Binary version: $version_output");
        }
    }
    
    return 0;
}

sub valdebug_server {
    my (@extra_args) = @_;
    
    # Check if valgrind is available
    my $valgrind_path = `which valgrind 2>/dev/null`;
    chomp $valgrind_path;
    unless ($valgrind_path && -x $valgrind_path) {
        print_error("valgrind not found. Please install valgrind to use this command.");
        print_info("Install with: sudo apt-get install valgrind  (Debian/Ubuntu)");
        print_info("            or: sudo yum install valgrind    (RHEL/CentOS)");
        return 1;
    }
    
    # Check if server is already running
    if (my $pid = is_running()) {
        print_warning("hlquery is already running (PID: $pid)");
        print_info("Please stop it first with: $0 stop");
        return 1;
    }
    
    # Check if config file exists
    unless (-f $config_path) {
        print_error("Configuration file not found: $config_path");
        print_info("Please run 'make install' or create a configuration file.");
        return 1;
    }
    
    # Create log directory if it doesn't exist
    unless (-d $log_dir_path) {
        mkdir $log_dir_path, 0755 or do {
            print_error("Could not create log directory: $log_dir_path");
            return 1;
        };
    }
    
    print_info("Starting hlquery with valgrind for memory debugging...");
    print_info("Running in detached mode (will fork to background)");
    print_info("Valgrind log will be written to: " . File::Spec->catfile($log_dir_path, 'valgrind.log'));
    print_info("Server logs will be in: $log_dir_path");
    print "";
    
    # Change to working directory
    chdir $working_dir or do {
        print_error("Could not change to working directory: $working_dir");
        return 1;
    };
    
    # Build valgrind command - NO --nofork so it runs in detached mode
    my @cmd = (
        $valgrind_path,
        '--leak-check=full',
        '--show-leak-kinds=all',
        '--track-origins=yes',
        '--verbose',
        '--error-limit=no',
        '--log-file=' . File::Spec->catfile($log_dir_path, 'valgrind.log'),
        '--trace-children=yes',  # Trace child processes after fork
        '--child-silent-after-fork=no',  # Don't silence child after fork
        $binary_path,
        '--debug',  # Keep debug mode but remove --nofork
        '--config', $config_path,
        @extra_args
    );
    
    # Execute valgrind with the binary in background
    my $pid = fork();
    if ($pid == 0) {
        # Child process: redirect output and execute
        open(STDOUT, '>', File::Spec->catfile($log_dir_path, 'valdebug.out')) or die "Cannot redirect stdout";
        open(STDERR, '>', File::Spec->catfile($log_dir_path, 'valdebug.err')) or die "Cannot redirect stderr";
        exec @cmd;
        exit 1;  # Should never reach here
    } elsif ($pid > 0) {
        # Parent process: wait a moment then check if child is still alive
        sleep(2);
        if (kill(0, $pid)) {
            print_success("hlquery started with valgrind (PID: $pid)");
            print_info("Monitor logs:");
            print_info("  Valgrind: $log_dir_path/valgrind.log");
            print_info("  Server: $log_dir_path/hlquery.log");
            print_info("  Stderr: $log_dir_path/valdebug.err");
            return 0;
        } else {
            print_error("hlquery failed to start with valgrind");
            print_info("Check logs: $log_dir_path/valdebug.err");
            return 1;
        }
    } else {
        print_error("Failed to fork for valgrind execution");
        return 1;
    }
    # exec never returns, but if it does, there was an error
    print_error("Failed to execute valgrind");
    return 1;
}

# Main execution
sub main {
    # Parse command line arguments first to check if we should show banner
    my $command;
    my $nofork = 0;
    my $debug = 0;
    my $skip_auth = 0;
    my $help = 0;
    my $version = 0;
    
    GetOptions(
        'nofork' => \$nofork,
        'debug' => \$debug,
        'skip-auth' => \$skip_auth,
        'config=s' => \$config_path,
        'pidfile=s' => \$pid_file_path,
        'logdir=s' => \$log_dir_path,
        'help' => \$help,
        'version' => \$version
    );
    
    # Get command
    $command = shift @ARGV;
    
    # Handle special options
    if ($help) {
        print_banner();
        print_usage();
        exit 0;
    }
    
    if ($version) {
        print_banner();
        exit 0;
    }
    
    unless ($command) {
        print_usage();
        exit 1;
    }
    
    # Handle help command
    if ($command eq 'help') {
        print_banner();
        print_usage();
        exit 0;
    }
    
    # Setup paths (needed for version command too)
    setup_paths();
    
    # Handle version command
    if ($command eq 'version') {
        print_banner();
        show_version();
        exit 0;
    }
    
    # Only show banner for non-start, non-status, and non-stop commands
    if ($command ne 'start' && $command ne 'status' && $command ne 'stop') {
        print_banner();
    }
    
    # Execute command
    my $result;
    if ($command eq 'start') {
        # Filter out 'start' from arguments and pass the rest to the binary
        my @extra_args = grep { $_ ne 'start' } @ARGV;
        $result = start_server($nofork, $debug, $skip_auth, @extra_args);
    } elsif ($command eq 'stop') {
        $result = stop_server();
    } elsif ($command eq 'kill') {
        $result = force_stop_server();
    } elsif ($command eq 'restart') {
        # Filter out 'restart' from arguments and pass the rest to the binary
        my @extra_args = grep { $_ ne 'restart' } @ARGV;
        $result = restart_server(@extra_args);
    } elsif ($command eq 'status') {
        $result = show_status();
    } elsif ($command eq 'reload') {
        print_warning("Reload functionality not yet implemented");
        $result = 1;
    } elsif ($command eq 'test') {
        $result = test_config();
    } elsif ($command eq 'sslgen') {
        my $sslgen_path = File::Spec->catfile($working_dir, "tools", "sslgen");
        if (-x $sslgen_path) {
            system($sslgen_path);
            $result = $? >> 8;
        } else {
            # Try relative to script if working_dir doesn't work (e.g. during dev)
            my $script_dir = dirname(File::Spec->rel2abs($0));
            $sslgen_path = File::Spec->catfile($script_dir, "tools", "sslgen");
            if (-x $sslgen_path) {
                system($sslgen_path);
                $result = $? >> 8;
            } else {
                print_error("sslgen tool not found at $sslgen_path");
                $result = 1;
            }
        }
    } elsif ($command eq 'valdebug') {
        # Filter out 'valdebug' from arguments and pass the rest to the binary
        my @extra_args = grep { $_ ne 'valdebug' } @ARGV;
        $result = valdebug_server(@extra_args);
    } else {
        print_error("Unknown command: $command");
        print_usage();
        $result = 1;
    }
    
    exit $result;
}

# Run main function
main();